[Unit]
Description=Halro independent dead-man monitor
Documentation=https://github.com/akz142857/Halro
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=halro-deadman
Group=halro-deadman
ExecStartPre=/usr/local/bin/halro-deadman -config /etc/halro-deadman/config.yaml -check-config
ExecStart=/usr/local/bin/halro-deadman -config /etc/halro-deadman/config.yaml
Restart=always
RestartSec=5s
RuntimeDirectory=halro-deadman
RuntimeDirectoryMode=0700
StateDirectory=halro-deadman
StateDirectoryMode=0700
LogsDirectory=halro-deadman
LogsDirectoryMode=0700
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/etc/halro-deadman
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
