    {"id": 3, "type": "stat", "title": "Mean request latency", "description": "Scrape-window mean; use histogram panels for tail latency after Phase C.", "datasource": {"type": "prometheus", "uid": "heimdall-prometheus"}, "targets": [{"refId": "A", "expr": "heimdall:request_duration:mean5m{environment=\"$environment\",cluster=\"$cluster\"}"}], "fieldConfig": {"defaults": {"unit": "s", "noValue": "N/A"}, "overrides": []}, "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5}},
