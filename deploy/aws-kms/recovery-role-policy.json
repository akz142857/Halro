{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BreakGlassDecryptOnlyTheRecoveryHalroKey",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:${RECOVERY_REGION}:${RECOVERY_ACCOUNT_ID}:key/${RECOVERY_KEY_ID}",
      "Condition": {
        "StringEquals": {
          "kms:EncryptionContext:halro.context_version": "1",
          "kms:EncryptionContext:halro.payload_version": "1",
          "kms:EncryptionContext:halro.purpose": "recovery",
          "kms:EncryptionContext:halro.instance_sha256": "${INSTANCE_ID_SHA256}"
        },
        "ForAllValues:StringEquals": {
          "kms:EncryptionContextKeys": [
            "halro.context_version",
            "halro.payload_version",
            "halro.purpose",
            "halro.instance_sha256",
            "halro.slot_sha256"
          ]
        }
      }
    }
  ]
}
