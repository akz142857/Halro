{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IndependentKeyAdministration",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::${RECOVERY_ACCOUNT_ID}:role/${RECOVERY_KMS_ADMIN_ROLE}"},
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "TemporaryBreakGlassDecrypt",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::${RECOVERY_ACCOUNT_ID}:role/${HALRO_RECOVERY_ROLE}"},
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:EncryptionContext:halro.context_version": "1",
          "kms:EncryptionContext:halro.payload_version": "1",
          "kms:EncryptionContext:halro.purpose": "recovery",
          "kms:EncryptionContext:halro.instance_sha256": "${INSTANCE_ID_SHA256}"
        }
      }
    },
    {
      "Sid": "ApprovedLifecycleRole",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::${RECOVERY_ACCOUNT_ID}:role/${HALRO_LIFECYCLE_ROLE}"},
      "Action": ["kms:Encrypt", "kms:Decrypt"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:EncryptionContext:halro.context_version": "1",
          "kms:EncryptionContext:halro.payload_version": "1",
          "kms:EncryptionContext:halro.purpose": "recovery",
          "kms:EncryptionContext:halro.instance_sha256": "${INSTANCE_ID_SHA256}"
        }
      }
    }
  ]
}
