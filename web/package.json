{
  "name": "halro-admin",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts && node scripts/check-bundle.mjs && node scripts/check-artifacts.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vite.config.ts",
    "test:watch": "vitest --config vite.config.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "preview:console": "node scripts/console-preview.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.3",
    "@tanstack/react-query": "5.106.1",
    "i18next": "26.7.2",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-i18next": "17.1.13",
    "uplot": "1.6.32",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
